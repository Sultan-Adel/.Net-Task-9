@model SchoolSystem.ViewModels.StudentFormViewModel

@{
    ViewData["Title"] = "Edit Student";
}

<h2>Edit Student</h2>

<form asp-controller="Student" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_StudentFormFields" model="Model" />
    <button type="submit" class="btn btn-warning">Update</button>
    <a asp-controller="Student" asp-action="GetAll" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model SchoolSystem.ViewModels.CourseFormViewModel

@{
    ViewData["Title"] = "Add Course";
}

<h2>Add Course</h2>
<form asp-action="Add" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="MinDegree" class="form-label"></label>
        <input asp-for="MinDegree" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Degree" class="form-label"></label>
        <input asp-for="Degree" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
